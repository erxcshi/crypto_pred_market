# Copy to .env and fill in what you need. Everything is optional except the
# Kalshi keys when running kalshi_ws / the trading engine.

# --- Data sink -------------------------------------------------------------
# parquet = local hourly parquet under data/ (the collector default you want)
# actual  = Supabase (legacy), test = append CSVs
DATA_SINK_MODE=parquet
# PARQUET_DATA_DIR=C:\somewhere\else\data     # default: <repo>/data

# --- Kalshi (kalshi_ws.py, trading engine) ----------------------------------
KALSHI_KEY_ID=
KALSHI_PRIVATE_KEY_PATH=
# Extra series for collection beyond KX{coin}15M + KX{coin}D, comma-separated
# (e.g. KXDOGE15M,KXADA15M for more markets/day):
# KALSHI_EXTRA_SERIES=
# Trading-engine only (burns public rate limit; leave unset for collection):
# KALSHI_POLL_SECONDS=1
# KALSHI_OB_OVERRIDE=1

# --- Alpaca free tier (SPY/QQQ via alpaca_ws.py) -----------------------------
ALPACA_API_KEY=
ALPACA_API_SECRET=

# --- Monitoring --------------------------------------------------------------
# Discord/Slack-compatible webhook for staleness alerts (optional):
# ALERT_WEBHOOK_URL=

# --- Legacy Supabase/Postgres (only for DATA_SINK_MODE=actual / old extracts) -
# SUPABASE_URL=
# SUPABASE_KEY=
# PASSWORD=
# HOST=
# PORT=
# DATABASE=
